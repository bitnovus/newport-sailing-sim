# Browser-visible configuration only. Never put secrets in VITE_* variables.
VITE_BASE_PATH=/

# Manual wind is the release-safe default. The public Open-Meteo endpoint is
# non-commercial; review its current terms before opting in.
VITE_ENABLE_LIVE_WIND=false
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Community-hosted map tiles. Public deployments must follow provider policies.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OPENSEAMAP_TILE_URL=https://tiles.openseamap.org/seamark/{z}/{x}/{y}.png

# Optional imagery requires both a licensed tile URL and complete attribution.
VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_ATTRIBUTION=
